rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário autenticado só pode ler e gravar o seu próprio documento (users/{uid})
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bloqueia qualquer outro acesso ao banco de dados
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
